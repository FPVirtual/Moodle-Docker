# =============================================================================
# new-moodle - Variables de entorno
# =============================================================================
# Configuración para sustituir www.fpvirtualaragon.es conectado a
# MariaDB 10.11.16 externo (moodle_mariadb_10.11.16, red mariadb_10.11.16_network)
# ---------------------------------------------------------------------------

# =============================================================================
# Base de datos (externa - MariaDB 10.11.16)
# =============================================================================

MOODLE_DB_HOST=moodle_mariadb
MOODLE_DB_PORT=3306
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=moodle_password

# Solo necesario si usas el perfil "with-db" (DB interna en el stack)
# En este despliegue NO se usa el perfil with-db.
MYSQL_ROOT_PASSWORD=root_password

# =============================================================================
# Moodle
# =============================================================================

MOODLE_URL=http://localhost:8080
VIRTUAL_HOST=
MOODLE_LANG=es
MOODLE_SITE_NAME="FP virtual - Aragón"
MOODLE_SITE_FULLNAME="FP virtual - Aragón"

MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=AeducAR#2020
MOODLE_ADMIN_EMAIL=pruizs@campusdigitalfp.com

# =============================================================================
# Código Moodle externo (opcional)
# =============================================================================
# Si usas docker-compose.override.yml para montar código externo, esta variable
# indica la ruta al código Moodle en el host.
# Ejemplos:
#   MOODLE_CODE_PATH=./moodle-code          # path relativo al proyecto
#   MOODLE_CODE_PATH=/opt/moodle            # path absoluto del servidor
#   MOODLE_CODE_PATH=/home/usuario/moodle   # otro path externo
#
# Si no usas docker-compose.override.yml, se usa el código empaquetado
# dentro de la imagen Docker.
# MOODLE_CODE_PATH=./moodle-code

# =============================================================================
# Proxy / SSL
# =============================================================================

SSL_PROXY=true
SSL_EMAIL=juandacorreo@gmail.com

# =============================================================================
# SMTP
# =============================================================================

SMTP_HOSTS=smtp.aragon.es:587
SMTP_USER=catedu_noreply@educa.aragon.es
SMTP_PASSWORD=NY0H9sUi5ICx9zfn-ma97j_a
SMTP_MAXBULK=100
NO_REPLY_ADDRESS=catedu_noreply@educa.aragon.es

# =============================================================================
# Otros
# =============================================================================

CRON_BROWSER_PASS=klavekronaeducar
INSTALL_TYPE=upgrade
VERSION=4.1.19

# Contraseñas específicas del entorno FPD
FPD_PASSWORD=Adm!n2Adm!n2
FPD_EMAIL=fpdistancia@aragon.es
MANAGER_PASSWORD=Cambiame1#
APP_PASSWORD=dem0#APP
APP_TEACHER_PASSWORD=Pr0f€sor


# =============================================================================
# Plugins de terceros
# =============================================================================
# Cada variable PLUGIN_<NOMBRE> controla si se instala/configura ese plugin.
# - true  : habilitado (se instala y configura)
# - false : deshabilitado (se omite)
# - Comentar la linea equivale a usar el valor 'default_enabled' de plugins.json
#
# Ejemplo: para desactivar un plugin, comenta su linea o pon 'false'.
# =============================================================================

PLUGIN_THEME_MOOVE=true
PLUGIN_FORMAT_TILES=true
PLUGIN_BLOCK_XP=true
PLUGIN_AVAILABILITY_XP=true
# PLUGIN_BLOCK_CONFIGURABLE_REPORTS=false
# PLUGIN_REPORT_COURSESTATS=false
PLUGIN_QUIZACCESS_ONESESSION=true
PLUGIN_MOD_CHOICEGROUP=true
PLUGIN_MOD_BOARD=true
PLUGIN_LOCAL_MAIL=true
PLUGIN_MOD_PDFANNOTATOR=true
PLUGIN_BLOCK_GRADE_ME=true
PLUGIN_BLOCK_COMPLETION_PROGRESS=true
PLUGIN_ATTO_FONTSIZE=true
PLUGIN_ATTO_FONTFAMILY=true
PLUGIN_ATTO_FULLSCREEN=true
PLUGIN_QTYPE_GAPFILL=true
PLUGIN_MOD_ATTENDANCE=true
PLUGIN_MOD_CHECKLIST=true
# PLUGIN_MOD_JITSI=false
# PLUGIN_BLOCK_SHARING_CART=false
# PLUGIN_LOCAL_REMINDERS=false
# PLUGIN_ATTO_C4L=false
# PLUGIN_MOD_GOOGLEMEET=false

# =============================================================================
# Integración Blackboard
# =============================================================================
BLACKBOARD_URL=
BLACKBOARD_KEY=
BLACKBOARD_SECRET=

