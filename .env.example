# =============================================================================
# Variables de entorno
# =============================================================================
# Copia este archivo a .env y personaliza los valores
# ---------------------------------------------------------------------------

# =============================================================================
# Imagen Dockerfile
# =============================================================================
# Estas variables controlan la construccion de la imagen Docker.
# Reconstruir con 'docker compose up -d --build' para aplicar cambios.

# Imagen base PHP. Incluye la version de PHP y el servidor web.
# Ejemplos:
#   PHP_BASE_IMAGE=php:8.1-fpm          # para stack nginx + php-fpm
#   PHP_BASE_IMAGE=php:8.2-apache       # para stack Apache + mod_php
PHP_BASE_IMAGE=php:8.2-apache

# Version de Moodle a descargar desde GitHub durante el build.
# Formato: X.Y.Z (sin 'v' inicial). Ejemplo: 4.5.11, 4.4.5, 4.1.19
MOODLE_VERSION=4.5.11

# Datos de test (NO activar en producción)
ENABLE_TEST_DATA=false

# =============================================================================
# Base de datos
# =============================================================================

# Host de la base de datos.
# - Si usas la DB interna (perfil with-db): dejar como "db"
# - Si usas una DB externa (otro contenedor o servidor): indicar IP o hostname
MOODLE_DB_HOST=db
MOODLE_DB_PORT=3306
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=cambiar_esta_contraseña

# Solo necesario si usas el perfil "with-db" (DB interna en el stack)
MYSQL_ROOT_PASSWORD=root_password_segura

# Imagen de MariaDB para el contenedor interno (perfil with-db).
# Cambiar la version requiere recrear el volumen db_data.
MARIADB_IMAGE=mariadb:10.11.16

# =============================================================================
# Moodle
# =============================================================================

MOODLE_URL=https://fpd.catedu.es
VIRTUAL_HOST=fpd.catedu.es
MOODLE_LANG=es
MOODLE_SITE_NAME="FP Virtual Aragón"
MOODLE_SITE_FULLNAME="Formación Profesional Virtual a Distancia de Aragón"

MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=cambiar_esta_contraseña
MOODLE_ADMIN_EMAIL=admin@catedu.es

# =============================================================================
# Código Moodle externo (opcional)
# =============================================================================
# Si usas docker-compose.override.yml para montar código externo, esta variable
# indica la ruta al código Moodle en el host.
# Ejemplos:
#   MOODLE_CODE_PATH=./moodle-code          # path relativo al proyecto
#   MOODLE_CODE_PATH=/opt/moodle            # path absoluto del servidor
#   MOODLE_CODE_PATH=/home/usuario/moodle   # otro path externo
#
# Si no usas docker-compose.override.yml, se usa el código empaquetado
# dentro de la imagen Docker.
# MOODLE_CODE_PATH=./moodle-code


# =============================================================================
# Proxy / SSL
# =============================================================================

SSL_PROXY=true
SSL_EMAIL=admin@catedu.es

# =============================================================================
# SMTP
# =============================================================================

SMTP_HOSTS=smtp.catedu.es
SMTP_USER=
SMTP_PASSWORD=
SMTP_MAXBULK=1
NO_REPLY_ADDRESS=noreply@catedu.es

# =============================================================================
# Otros
# =============================================================================

CRON_BROWSER_PASS=

# Contraseñas específicas del entorno FPVirtual
FPVIRTUAL_PASSWORD=
FPVIRTUAL_EMAIL=
MANAGER_PASSWORD=
APP_PASSWORD=
APP_TEACHER_PASSWORD=
API_USER_PASSWORD=

# =============================================================================
# Plugins de terceros
# =============================================================================
# Cada variable PLUGIN_<NOMBRE> controla si se instala/configura ese plugin.
# - true  : habilitado (se instala y configura)
# - false : deshabilitado (se omite)
# - Comentar la linea equivale a usar el valor 'default_enabled' de plugins.json
#
# Ejemplo: para desactivar un plugin, comenta su linea o pon 'false'.
# =============================================================================

PLUGIN_THEME_MOOVE=true
PLUGIN_FORMAT_TILES=true
PLUGIN_BLOCK_XP=true
PLUGIN_AVAILABILITY_XP=true
# PLUGIN_BLOCK_CONFIGURABLE_REPORTS=false
# PLUGIN_REPORT_COURSESTATS=false
PLUGIN_QUIZACCESS_ONESESSION=true
PLUGIN_MOD_CHOICEGROUP=true
PLUGIN_MOD_BOARD=true
PLUGIN_LOCAL_MAIL=true
PLUGIN_MOD_PDFANNOTATOR=true
PLUGIN_BLOCK_GRADE_ME=true
PLUGIN_BLOCK_COMPLETION_PROGRESS=true
PLUGIN_ATTO_FONTSIZE=true
PLUGIN_ATTO_FONTFAMILY=true
PLUGIN_ATTO_FULLSCREEN=true
PLUGIN_QTYPE_GAPFILL=true
PLUGIN_MOD_ATTENDANCE=true
PLUGIN_MOD_CHECKLIST=true
# PLUGIN_MOD_JITSI=false
# PLUGIN_BLOCK_SHARING_CART=false
# PLUGIN_LOCAL_REMINDERS=false
# PLUGIN_ATTO_C4L=false
PLUGIN_MOD_GOOGLEMEET=true           # Fork hyukudan v2.7.3 (por defecto)
# PLUGIN_MOD_GOOGLEMEET_LEGACY=true  # Version original ronefel (Moodle 4.1). Solo una debe estar activa.

